<?xml version="1.0" encoding="utf-8"?>
<!-- Ajudant sense icona: baixa la cartellera dels cinemes i la dona al launcher (config.xml info_provider =
     cat.latdg.temps). Sense serveis en segon pla. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- L'únic permís: les webs dels cinemes, TMDB i el traductor de Softcatalà -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Cartellera">

        <!-- La fitxa d'una pel·lícula de la cartellera: s'obre amb OK des d'un pòster del launcher. -->
        <activity
            android:name=".FilmActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="com.gathin.tvhome.action.SHOW_FILM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".TempsProvider"
            android:authorities="cat.latdg.temps"
            android:exported="true" />
    </application>
</manifest>
